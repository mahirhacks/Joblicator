<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ contact.name }} - Cover Letter</title>
  <style>
    @page {
      size: A4;
      margin: 1.75cm 1.95cm 1.9cm;
    }
    * {
      box-sizing: border-box;
    }
    html,
    body {
      margin: 0;
      padding: 0;
    }
    body {
      color: #20252b;
      background: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10.5pt;
      line-height: 1.58;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    .sender {
      padding-bottom: 0.45cm;
      margin-bottom: 0.45cm;
      border-bottom: 1.5pt solid #20252b;
    }
    .sender-name {
      margin: 0;
      color: #172033;
      font-size: 21pt;
      font-weight: bold;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
    .sender-line {
      margin: 0.14cm 0 0;
      color: #59616d;
      font-size: 7.75pt;
      line-height: 1.35;
    }
    .letter-details {
      margin: 0 0 0.36cm;
      line-height: 1.45;
    }
    .letter-details p,
    .letter-details time {
      display: block;
      margin: 0;
    }
    .letter-details time {
      margin-bottom: 0.32cm;
    }
    .subject {
      margin: 0.32cm 0 0;
      color: #172033;
      font-weight: bold;
    }
    .salutation {
      margin: 0.42cm 0 0.15cm;
    }
    .body-text,
    .closing-text {
      margin: 0 0 0.34cm;
      orphans: 3;
      widows: 3;
    }
    .sign-off {
      display: flex;
      flex-direction: column;
      min-height: 1.35cm;
      margin-top: 0.38cm;
    }
    .sign-off .line {
      margin: 0;
    }
  </style>
</head>
<body data-document-layout="joblication-live-v1">
  <header class="sender">
    <h1 class="sender-name">{{ contact.name }}</h1>
    {% if contact.email or contact.phone or contact.address %}
    <p class="sender-line">
      {% if contact.email %}{{ contact.email }}{% endif %}
      {% if contact.email and contact.phone %} | {% endif %}
      {% if contact.phone %}{{ contact.phone }}{% endif %}
      {% if (contact.email or contact.phone) and contact.address %} | {% endif %}
      {% if contact.address %}{{ contact.address }}{% endif %}
    </p>
    {% endif %}
  </header>

  <section class="letter-details">
    {% if date %}<time>{{ date }}</time>{% endif %}
    <p>{{ addressee or "Hiring Manager" }}</p>
    {% if company_name %}<p>{{ company_name }}</p>{% endif %}
    {% if role_title %}<p>{{ role_title }}</p>{% endif %}
    {% if subject_line %}<p class="subject"><strong>Re:</strong> {{ subject_line }}</p>{% endif %}
  </section>

  <p class="salutation">Dear {{ addressee or "Hiring Manager" }},</p>
  {% if opening_paragraph %}<p class="body-text">{{ opening_paragraph }}</p>{% endif %}
  {% for paragraph in body_paragraphs %}<p class="body-text">{{ paragraph }}</p>{% endfor %}
  {% if closing_paragraph %}<p class="closing-text">{{ closing_paragraph }}</p>{% endif %}

  <div class="sign-off">
    {% for line in sign_off_lines %}<p class="line">{{ line }}</p>{% endfor %}
  </div>
</body>
</html>
