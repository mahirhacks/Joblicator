{
    "defaults": {
        "cv": "cv_professional",
        "cover_letter": "cover_letter_formal"
    },
    "catalog": {
        "cv_professional": {
            "name": "Professional CV",
            "category": "cv",
            "path": "templates/cv/professional.html.j2",
